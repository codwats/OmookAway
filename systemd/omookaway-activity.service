[Unit]
Description=OmookAway aggregate activity observer
PartOf=graphical-session.target
After=omookaway.service
Requires=omookaway.service

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/qs -p %h/.local/share/omookaway/activity
ExecStopPost=-/usr/bin/env omookaway activity-observation unavailable
Restart=on-failure

[Install]
WantedBy=graphical-session.target
